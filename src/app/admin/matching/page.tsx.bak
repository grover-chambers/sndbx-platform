"use client"

import { useEffect, useState } from "react"
import { useSession } from "next-auth/react"
import { useRouter } from "next/navigation"
import {
  Target, Users, Building2, DollarSign, Clock, Star,
  TrendingUp, CheckCircle, XCircle, AlertCircle,
  Filter, Search, RefreshCw, ChevronRight, Sparkles,
  Award, Zap, Activity, MessageSquare, Calendar, Eye, Send
} from "lucide-react"
import Link from "next/link"

interface PendingClient {
  id: string
  companyName: string
  industry: string | null
  size: string | null
  user: { name: string; email: string }
  needsAssessment: {
    serviceTypes: string[]
    budgetRange: string | null
    timeline: string | null
    additionalContext: string | null
    submittedAt: string
  }
}

interface Stats {
  totalMatches: number
  activeMatches: number
  completedMatches: number
  successRate: number
  avgTimeToMatch: number
}

export default function AdminMatchingPage() {
  const { data: session, status } = useSession()
  const router = useRouter()
  const [pendingClients, setPendingClients] = useState<PendingClient[]>([])
  const [stats, setStats] = useState<Stats | null>(null)
  const [loading, setLoading] = useState(true)
  const [search, setSearch] = useState("")
  const [selectedClient, setSelectedClient] = useState<PendingClient | null>(null)

  useEffect(() => {
    if (status === "unauthenticated") {
      router.push("/auth/login")
    }
    if (status === "authenticated" && session?.user?.role !== "SUPER_ADMIN" && session?.user?.role !== "ADMIN") {
      router.push("/portal/client/dashboard")
    }
    fetchQueue()
  }, [status, session, router])

  const fetchQueue = async () => {
    setLoading(true)
    try {
      const res = await fetch("/api/admin/matching/queue")
      const data = await res.json()
      if (data.success) {
        setPendingClients(data.pendingClients)
        setStats(data.stats)
      }
    } catch (error) {
      console.error("Failed to fetch queue:", error)
    } finally {
      setLoading(false)
    }
  }

  const filteredClients = pendingClients.filter(client =>
    client.companyName.toLowerCase().includes(search.toLowerCase()) ||
    client.user.email.toLowerCase().includes(search.toLowerCase())
  )

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-teal-600"></div>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-slate-50">
      {/* Header */}
      <div className="bg-gradient-to-r from-navy-900 to-navy-800 text-white">
        <div className="px-4 py-6 md:px-6">
          <h1 className="text-2xl md:text-3xl font-serif font-bold">Matching Intelligence</h1>
          <p className="text-white/80 mt-1 text-sm">Match clients with specialist companies based on needs assessments</p>
        </div>
      </div>

      <div className="p-4 md:p-6">
        {/* Stats Cards */}
        {stats && (
          <div className="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
            <div className="bg-white rounded-xl border border-slate-200 p-4">
              <div className="flex items-center gap-2 text-slate-500 text-sm mb-1">
                <Target className="w-4 h-4" />
                Total Matches
              </div>
              <p className="text-2xl font-bold text-navy-900">{stats.totalMatches}</p>
            </div>
            <div className="bg-white rounded-xl border border-slate-200 p-4">
              <div className="flex items-center gap-2 text-slate-500 text-sm mb-1">
                <TrendingUp className="w-4 h-4 text-green-600" />
                Active
              </div>
              <p className="text-2xl font-bold text-navy-900">{stats.activeMatches}</p>
            </div>
            <div className="bg-white rounded-xl border border-slate-200 p-4">
              <div className="flex items-center gap-2 text-slate-500 text-sm mb-1">
                <CheckCircle className="w-4 h-4 text-teal-600" />
                Completed
              </div>
              <p className="text-2xl font-bold text-navy-900">{stats.completedMatches}</p>
            </div>
            <div className="bg-white rounded-xl border border-slate-200 p-4">
              <div className="flex items-center gap-2 text-slate-500 text-sm mb-1">
                <Award className="w-4 h-4 text-amber-600" />
                Success Rate
              </div>
              <p className="text-2xl font-bold text-navy-900">{stats.successRate}%</p>
            </div>
            <div className="bg-white rounded-xl border border-slate-200 p-4">
              <div className="flex items-center gap-2 text-slate-500 text-sm mb-1">
                <Clock className="w-4 h-4 text-blue-600" />
                Avg Time to Match
              </div>
              <p className="text-2xl font-bold text-navy-900">{stats.avgTimeToMatch} days</p>
            </div>
          </div>
        )}

        {/* Pending Queue Section */}
        <div className="mb-6">
          <div className="flex justify-between items-center mb-4">
            <h2 className="text-lg font-semibold text-navy-900 flex items-center gap-2">
              <Users className="w-5 h-5 text-teal-600" />
              Pending Matching Queue ({pendingClients.length})
            </h2>
            <div className="flex gap-2">
              <div className="relative">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
                <input
                  type="text"
                  placeholder="Search clients..."
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  className="pl-9 pr-4 py-2 text-sm border border-slate-200 rounded-lg w-64 focus:outline-none focus:ring-2 focus:ring-teal-500"
                />
              </div>
              <button onClick={fetchQueue} className="p-2 border border-slate-200 rounded-lg hover:bg-slate-50 transition">
                <RefreshCw className="w-4 h-4 text-slate-500" />
              </button>
            </div>
          </div>

          {filteredClients.length === 0 ? (
            <div className="bg-white rounded-xl border border-slate-200 p-12 text-center">
              <CheckCircle className="w-12 h-12 mx-auto text-green-500 mb-3" />
              <h3 className="text-lg font-semibold text-slate-900 mb-1">All caught up!</h3>
              <p className="text-sm text-slate-500">No pending clients waiting for matching</p>
            </div>
          ) : (
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
              {filteredClients.map((client) => (
                <div
                  key={client.id}
                  className={`bg-white rounded-xl border p-5 hover:shadow-md transition cursor-pointer ${
                    selectedClient?.id === client.id ? "border-teal-500 bg-teal-50/20 ring-2 ring-teal-500" : "border-slate-200"
                  }`}
                  onClick={() => setSelectedClient(client)}
                >
                  <div className="flex items-start justify-between">
                    <div>
                      <h3 className="font-semibold text-slate-900">{client.companyName}</h3>
                      <p className="text-sm text-slate-500">{client.user.email}</p>
                      <div className="flex gap-2 mt-2">
                        {client.industry && (
                          <span className="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{client.industry}</span>
                        )}
                        {client.size && (
                          <span className="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">{client.size} emp</span>
                        )}
                      </div>
                    </div>
                    <div className="text-right">
                      <div className="flex flex-wrap gap-1 justify-end mb-2">
                        {client.needsAssessment.serviceTypes.slice(0, 2).map((service) => (
                          <span key={service} className="text-xs bg-teal-50 text-teal-700 px-2 py-0.5 rounded-full">
                            {service.split(" ").slice(0, 2).join(" ")}
                          </span>
                        ))}
                        {client.needsAssessment.serviceTypes.length > 2 && (
                          <span className="text-xs text-slate-400">+{client.needsAssessment.serviceTypes.length - 2}</span>
                        )}
                      </div>
                      <p className="text-xs text-slate-400">Submitted: {new Date(client.needsAssessment.submittedAt).toLocaleDateString()}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Selected Client Details & Matching */}
        {selectedClient && (
          <div className="bg-white rounded-xl border border-slate-200 p-6">
            <div className="flex justify-between items-start mb-4">
              <h3 className="text-lg font-semibold text-navy-900">Client Needs Assessment</h3>
              <button
                onClick={() => router.push(`/admin/matching/match?client=${selectedClient.id}`)}
                className="px-4 py-2 bg-teal-600 text-white rounded-lg text-sm hover:bg-teal-700 transition flex items-center gap-2"
              >
                <Send className="w-4 h-4" />
                Start Matching
              </button>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <h4 className="font-semibold text-slate-700 mb-2">Business Info</h4>
                <div className="space-y-2 text-sm">
                  <p><span className="text-slate-500">Industry:</span> {selectedClient.industry || "—"}</p>
                  <p><span className="text-slate-500">Company Size:</span> {selectedClient.size || "—"}</p>
                  <p><span className="text-slate-500">Budget:</span> {selectedClient.needsAssessment.budgetRange || "—"}</p>
                  <p><span className="text-slate-500">Timeline:</span> {selectedClient.needsAssessment.timeline || "—"}</p>
                </div>
              </div>
              <div>
                <h4 className="font-semibold text-slate-700 mb-2">Service Needs</h4>
                <div className="flex flex-wrap gap-1 mb-3">
                  {selectedClient.needsAssessment.serviceTypes.map((service) => (
                    <span key={service} className="text-xs bg-teal-50 text-teal-700 px-2 py-1 rounded-full">
                      {service}
                    </span>
                  ))}
                </div>
                {selectedClient.needsAssessment.additionalContext && (
                  <div>
                    <h4 className="font-semibold text-slate-700 mb-1">Additional Context</h4>
                    <p className="text-sm text-slate-600">{selectedClient.needsAssessment.additionalContext}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
